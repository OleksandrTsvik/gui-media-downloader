QMainWindow {
    background-color: #f5f6fa;
}

QGroupBox {
    font-size: 13px;
    font-weight: bold;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLineEdit, QComboBox {
    background-color: white;
    border: 1px solid #dcdde1;
    border-radius: 5px;
    padding: 8px;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:disabled {
    background-color: #bdc3c7;
}

QProgressBar {
    border: 1px solid #dcdde1;
    border-radius: 5px;
    height: 22px;
    text-align: center;
    background-color: white;
}

QProgressBar::chunk {
    background-color: #2ecc71;
    border-radius: 4px;
}

QLabel {
    color: #2c3e50;
}